{
  "name": "basictodo",
  "module": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:prod": "cross-env BUN_ENV=production bun start",
    "watch:server": "bun --hot --no-clear-screen src/main.ts",
    "watch:types": "bun run type-check --watch --preserveWatchOutput",
    "watch": "concurrently --names \"SERVER,TYPES,STYLES\" -c \"green.bold,blue.bold,yellow.bold\" \"bun:watch:server\" \"bun:watch:types\"",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "BUN_ENV=test bun test",
    "test:coverage": "BUN_ENV=test bun test --coverage",
    "db:migrate": "migralite -d db/main.sqlite",
    "prepare": "bun .husky/install.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/bun": "1.2.2",
    "concurrently": "9.1.2",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "migralite": "1.1.1",
    "pino-pretty": "11.2.2",
    "prettier": "3.3.3",
    "typed-htmx": "0.3.1",
    "typescript-eslint": "7.18.0",
    "ws": "8.18.0"
  },
  "peerDependencies": {
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "cross-env": "7.0.3",
    "hono": "4.7.1",
    "nanoid": "5.0.9",
    "pino": "9.6.0",
    "zod": "3.24.1"
  }
}
